diff --git a/src/server/aws-backend/reviews-gateway.ts b/src/server/aws-backend/reviews-gateway.ts
new file mode 100644
index 0000000..0669630
--- /dev/null
+++ b/src/server/aws-backend/reviews-gateway.ts
@@ -0,0 +1,41 @@
+// AWS Lambda supplies the SDK; bundle with this package external.
+const {SecretsManagerClient,GetSecretValueCommand}=require('@aws-sdk/client-secrets-manager');
+import { Pool } from 'pg';
+import { z } from 'zod';
+import { moderatorReviews, publicReviews } from './reviews-service';
+import type { Database, SqlClient } from './database';
+import { ReviewError } from './reviews-service';
+const sm=new SecretsManagerClient({region:'us-east-2'});
+let pool:Pool|undefined;
+async function database(publicOnly:boolean):Promise<Database>{
+ if(!pool){
+  const arn=process.env.REVIEWS_DATABASE_SECRET_ARN;
+  if(!arn||!arn.startsWith('arn:aws:secretsmanager:us-east-2:337058058945:secret:karpilo-feedback/'))throw Error('Dedicated feedback secret required');
+  const secret=JSON.parse((await sm.send(new GetSecretValueCommand({SecretId:arn}))).SecretString??'{}');
+  const u=new URL(secret.connection);if(u.protocol!=='postgresql:'||u.search||!secret.ca)throw Error('Invalid database configuration');
+  pool=new Pool({host:u.hostname,port:Number(u.port)||5432,database:u.pathname.slice(1),user:decodeURIComponent(u.username),password:decodeURIComponent(u.password),ssl:{rejectUnauthorized:true,ca:secret.ca,servername:u.hostname},max:2,connectionTimeoutMillis:4000,idleTimeoutMillis:10000});
+ }
+ const current=pool;
+ return {transaction:async(owner,fn)=>{const c=await current.connect();try{await c.query('BEGIN');const role=(await c.query('SELECT rolsuper,rolbypassrls FROM pg_roles WHERE rolname=current_user')).rows[0];if(role.rolsuper||role.rolbypassrls)throw Error('Unsafe database role');await c.query(publicOnly?'SET LOCAL ROLE karpilo_reviews_public':'SET LOCAL ROLE karpilo_feedback_moderator');await c.query("SELECT set_config('karpilo.owner_id',$1,true)",[owner]);await c.query("SET LOCAL statement_timeout='5000ms'");const r=await fn(c as SqlClient);await c.query('COMMIT');return r;}catch(e){await c.query('ROLLBACK');throw e;}finally{c.release();}}};
+}
+type Event={rawPath:string;body?:string;isBase64Encoded?:boolean;queryStringParameters?:Record<string,string>;requestContext:{http:{method:string};authorizer?:{iam?:{userArn?:string}}}};
+export async function handler(e:Event){
+ const response=(statusCode:number,body:unknown)=>({statusCode,headers:{'content-type':'application/json','cache-control':'no-store'},body:JSON.stringify(body)});
+ try{
+  if(process.env.AWS_REVIEWS_ENABLED!=='true')return response(503,{error:'Feedback not enabled'});
+  const method=e.requestContext.http.method;
+  if(e.rawPath==='/v1/reviews'&&method==='GET')return response(200,await publicReviews(await database(true),Number(e.queryStringParameters?.offset??0)));
+  if(e.rawPath!=='/v1/feedback'||!['GET','POST'].includes(method))return response(404,{error:'Not found'});
+  // API Gateway AWS_IAM is mandatory; Lambda also pins the authorized principal.
+  const actor=e.requestContext.authorizer?.iam?.userArn;
+  if(!actor||!process.env.REVIEWS_HQ_PRINCIPAL_ARN||actor!==process.env.REVIEWS_HQ_PRINCIPAL_ARN)return response(403,{error:'Founder gateway access required'});
+  const service=moderatorReviews(await database(false),actor);
+  if(method==='GET')return response(200,await service.list(Number(e.queryStringParameters?.offset??0)));
+  const raw=e.isBase64Encoded?Buffer.from(e.body??'','base64').toString('utf8'):e.body??'';
+  if(Buffer.byteLength(raw)>20000)return response(413,{error:'Request too large'});
+  const input=JSON.parse(raw),{action,id,...payload}=input;
+  if(action==='reply')return response(200,await service.reply(id,payload));
+  if(action==='moderate')return response(200,await service.moderate(id,payload));
+  return response(400,{error:'Invalid action'});
+ }catch(e){const status=e instanceof ReviewError?e.status:e instanceof z.ZodError||e instanceof SyntaxError?400:503;return response(status,{error:status===409?'Conversation changed':status===400?'Invalid request':'Feedback unavailable'});}
+}
diff --git a/src/server/aws-backend/reviews-service.ts b/src/server/aws-backend/reviews-service.ts
new file mode 100644
index 0000000..2503773
--- /dev/null
+++ b/src/server/aws-backend/reviews-service.ts
@@ -0,0 +1,68 @@
+import { randomUUID } from 'node:crypto';
+import { z } from 'zod';
+export class ReviewError extends Error { constructor(public status:number,message:string){super(message);} }
+import { accountOwnerSchema } from './identity';
+import type { Database } from './database';
+
+const submission = z.object({requestId:z.uuid(),kind:z.enum(['feedback','review']),displayName:z.string().trim().min(1).max(80),rating:z.number().int().min(1).max(5).optional(),body:z.string().trim().min(1).max(4000),publicConsent:z.boolean()}).strict().superRefine((d,c)=>{
+ if(d.kind==='feedback' && d.publicConsent)c.addIssue({code:'custom',message:'Private feedback cannot be published'});
+ if(d.kind==='review' && (!d.publicConsent || !d.rating))c.addIssue({code:'custom',message:'A public review requires a rating and explicit consent'});
+});
+const page = (offset: number) => z.number().int().min(0).max(100000).parse(offset);
+export function requireReviews(env=process.env){if(env.AWS_REVIEWS_ENABLED!=='true')throw new ReviewError(503,'Reviews and feedback are not enabled yet');}
+export function subscriberReviews(db:Database,owner:string){
+ accountOwnerSchema.parse(owner);
+ return {
+  async list(offset=0){page(offset);return db.transaction(owner,async sql=>{
+   const threads=(await sql.query(`SELECT id,kind,display_name,rating,body,public_consent,publication,version,created_at FROM karpilo.feedback_threads WHERE owner_id=$1 ORDER BY created_at DESC,id DESC LIMIT 51 OFFSET $2`,[owner,offset])).rows;
+   const replies=(await sql.query(`SELECT id,thread_id,body,created_at,read_at FROM karpilo.feedback_replies WHERE owner_id=$1 AND thread_id=ANY($2::uuid[]) ORDER BY created_at,id`,[owner,threads.slice(0,50).map(t=>t.id)])).rows;
+   return {threads:threads.slice(0,50),replies,nextOffset:threads.length>50?offset+50:null};
+  });},
+  async submit(input:unknown){const d=submission.parse(input);return db.transaction(owner,async sql=>{
+   // Serialize duplicate keys and per-account limits; never overwrite the original message.
+   await sql.query('SELECT pg_advisory_xact_lock(hashtext($1))',['feedback:'+owner]);
+   const prior=(await sql.query('SELECT * FROM karpilo.feedback_threads WHERE owner_id=$1 AND request_id=$2',[owner,d.requestId])).rows[0];
+   if(prior){if(prior.kind!==d.kind||prior.body!==d.body||prior.display_name!==d.displayName||prior.rating!==(d.rating??null)||prior.public_consent!==d.publicConsent)throw new ReviewError(409,'Submission key already used');return {id:prior.id,duplicate:true};}
+   const count=(await sql.query("SELECT count(*)::int n FROM karpilo.feedback_threads WHERE owner_id=$1 AND created_at>now()-interval '1 day'",[owner])).rows[0];
+   if(Number(count?.n)>=10)throw new ReviewError(429,'Daily feedback limit reached');
+   const id=randomUUID();await sql.query('INSERT INTO karpilo.feedback_threads(id,owner_id,request_id,kind,display_name,rating,body,public_consent,publication) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9)',[id,owner,d.requestId,d.kind,d.displayName,d.rating??null,d.body,d.publicConsent,d.kind==='review'?'pending':'private']);
+   return {id,duplicate:false};
+  });},
+  async withdraw(id:string){z.uuid().parse(id);return db.transaction(owner,async sql=>{const r=await sql.query("UPDATE karpilo.feedback_threads SET public_consent=false,publication='private',version=version+1,updated_at=now() WHERE id=$1 AND owner_id=$2 RETURNING id",[id,owner]);if(!r.rows.length)throw new ReviewError(404,'Review not found');return {ok:true};});},
+  async inbox(){return db.transaction(owner,async sql=>({notifications:(await sql.query('SELECT id,thread_id,body,created_at,read_at FROM karpilo.feedback_replies WHERE owner_id=$1 ORDER BY created_at DESC,id DESC LIMIT 100',[owner])).rows,unread:Number((await sql.query('SELECT count(*)::int n FROM karpilo.feedback_replies WHERE owner_id=$1 AND read_at IS NULL',[owner])).rows[0]?.n??0)}));},
+  async read(id:string){z.uuid().parse(id);return db.transaction(owner,async sql=>{const r=await sql.query('UPDATE karpilo.feedback_replies SET read_at=coalesce(read_at,now()) WHERE id=$1 AND owner_id=$2 RETURNING id',[id,owner]);if(!r.rows.length)throw new ReviewError(404,'Reply not found');return {ok:true};});}
+ };
+}
+
+// Only authenticated founder routes or an IAM-authorized AWS gateway may call this service.
+export function moderatorReviews(db:Database,actor:string){
+ accountOwnerSchema.parse(actor);
+ return {
+  async list(offset=0){page(offset);return db.transaction('feedback-review',async sql=>{
+   const threads=(await sql.query('SELECT * FROM karpilo.feedback_threads ORDER BY created_at DESC,id DESC LIMIT 51 OFFSET $1',[offset])).rows;
+   const replies=(await sql.query('SELECT id,thread_id,body,created_at,read_at FROM karpilo.feedback_replies WHERE thread_id=ANY($1::uuid[]) ORDER BY created_at,id',[threads.slice(0,50).map(t=>t.id)])).rows;
+   return {threads:threads.slice(0,50),replies,nextOffset:threads.length>50?offset+50:null};
+  });},
+  async reply(id:string,input:unknown){z.uuid().parse(id);const d=z.object({requestId:z.uuid(),body:z.string().trim().min(1).max(4000)}).strict().parse(input);return db.transaction('feedback-review',async sql=>{
+   const thread=(await sql.query('SELECT owner_id,version FROM karpilo.feedback_threads WHERE id=$1 FOR UPDATE',[id])).rows[0];if(!thread)throw new ReviewError(404,'Feedback not found');
+   const prior=(await sql.query('SELECT id,body FROM karpilo.feedback_replies WHERE thread_id=$1 AND request_id=$2',[id,d.requestId])).rows[0];
+   if(prior){if(prior.body!==d.body)throw new ReviewError(409,'Reply key already used');return {id:prior.id,duplicate:true};}
+   const replyId=randomUUID();
+   // The reply IS the durable inbox notification: a single transaction, no second delivery hop.
+   await sql.query('INSERT INTO karpilo.feedback_replies(id,thread_id,owner_id,request_id,actor,body) VALUES($1,$2,$3,$4,$5,$6)',[replyId,id,thread.owner_id,d.requestId,actor,d.body]);
+   await sql.query("INSERT INTO karpilo.feedback_audit(thread_id,actor,action,version) VALUES($1,$2,'reply',$3)",[id,actor,thread.version]);
+   return {id:replyId,duplicate:false,inbox:'saved'};
+  });},
+  async moderate(id:string,input:unknown){z.uuid().parse(id);const d=z.object({publication:z.enum(['published','withheld']),reason:z.string().trim().min(1).max(500),expectedVersion:z.number().int().positive()}).strict().parse(input);return db.transaction('feedback-review',async sql=>{
+   const row=(await sql.query('SELECT kind,public_consent,version FROM karpilo.feedback_threads WHERE id=$1 FOR UPDATE',[id])).rows[0];if(!row)throw new ReviewError(404,'Review not found');
+   if(row.version!==d.expectedVersion)throw new ReviewError(409,'Review changed. Reload before moderating');
+   if(row.kind!=='review'||!row.public_consent)throw new ReviewError(409,'Subscriber has not consented to publication');
+   await sql.query('UPDATE karpilo.feedback_threads SET publication=$2,moderation_reason=$3,version=version+1,updated_at=now() WHERE id=$1',[id,d.publication,d.reason]);
+   await sql.query('INSERT INTO karpilo.feedback_audit(thread_id,actor,action,version) VALUES($1,$2,$3,$4)',[id,actor,d.publication,d.expectedVersion+1]);return {ok:true};
+  });}
+ };
+}
+export async function publicReviews(db:Database,offset=0){page(offset);return db.transaction('feedback-public',async sql=>{
+ const rows=(await sql.query("SELECT id,display_name,rating,body,created_at FROM karpilo.feedback_threads WHERE kind='review' AND publication='published' AND public_consent ORDER BY created_at DESC,id DESC LIMIT 21 OFFSET $1",[offset])).rows;
+ return {reviews:rows.slice(0,20),nextOffset:rows.length>20?offset+20:null};
+});}
diff --git a/tests/integrations/reviews.test.ts b/tests/integrations/reviews.test.ts
new file mode 100644
index 0000000..4cee82e
--- /dev/null
+++ b/tests/integrations/reviews.test.ts
@@ -0,0 +1,45 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {randomUUID} from 'node:crypto';
+import {PGlite} from '@electric-sql/pglite';
+import type {Database,SqlClient} from '../../src/server/aws-backend/database';
+import {subscriberReviews,moderatorReviews,publicReviews} from '../../src/server/aws-backend/reviews-service';
+async function fixture(run:(p:PGlite,owner:(id:string)=>ReturnType<typeof subscriberReviews>,admin:ReturnType<typeof moderatorReviews>,pub:()=>ReturnType<typeof publicReviews>)=>Promise<void>){
+ const p=new PGlite();try{
+  await p.exec('CREATE SCHEMA karpilo; CREATE ROLE karpilo_runtime; CREATE ROLE karpilo_support; GRANT USAGE ON SCHEMA karpilo TO karpilo_runtime,karpilo_support;');
+  await p.exec("CREATE TABLE karpilo.feedback_requests(owner_id text,campaign text,rating integer,comment text,responded_at timestamptz);");
+  await p.exec(await readFile('database/aws/019_feedback_conversations.sql','utf8'));
+  const db=(role:string):Database=>({transaction:async(owner,fn)=>p.transaction(async tx=>{await tx.exec('SET LOCAL ROLE '+role);await tx.query("SELECT set_config('karpilo.owner_id',$1,true)",[owner]);return fn({query:async(sql,v)=>sql.includes('pg_advisory_xact_lock')?{rows:[]}:tx.query(sql,v)} as SqlClient);})});
+  await run(p,id=>subscriberReviews(db('karpilo_runtime'),id),moderatorReviews(db('karpilo_support'),'founder'),()=>publicReviews(db('karpilo_reviews_public')));
+ }finally{await p.close();}
+}
+const message=(kind='feedback')=>({requestId:randomUUID(),kind,displayName:'Driver',body:'Useful feedback',rating:3,publicConsent:kind==='review'});
+test('private feedback stays private and tenant isolated; duplicate submissions do not duplicate',()=>fixture(async(_p,owner,admin,pub)=>{
+ const d=message(),a=owner('a'),b=owner('b');const r=await a.submit(d);assert.equal((await a.submit(d)).duplicate,true);
+ assert.equal((await a.list()).threads.length,1);assert.equal((await b.list()).threads.length,0);assert.equal((await admin.list()).threads.length,1);assert.equal((await pub()).reviews.length,0);
+ await assert.rejects(a.submit({...d,body:'changed'}));await assert.rejects(admin.moderate(String(r.id),{publication:'published',expectedVersion:1,reason:'publish'}));
+}));
+test('moderation needs consent and current version; withdrawal immediately removes public review',()=>fixture(async(_p,owner,admin,pub)=>{
+ const a=owner('a');await assert.rejects(a.submit({...message('review'),publicConsent:false}));const r=await a.submit(message('review'));
+ assert.equal((await pub()).reviews.length,0);await admin.moderate(String(r.id),{publication:'published',expectedVersion:1,reason:'Relevant first-hand review'});
+ const published=(await pub()).reviews[0];assert.equal(published.rating,3);assert.deepEqual(Object.keys(published).sort(),['body','created_at','display_name','id','rating']);
+ await assert.rejects(admin.moderate(String(r.id),{publication:'withheld',expectedVersion:1,reason:'stale'}));
+ await a.withdraw(String(r.id));assert.equal((await pub()).reviews.length,0);await assert.rejects(admin.moderate(String(r.id),{publication:'published',expectedVersion:3,reason:'cannot override withdrawal'}));
+}));
+test('reply is exactly one durable inbox notice, only owner may read it',()=>fixture(async(_p,owner,admin)=>{
+ const a=owner('a'),b=owner('b'),r=await a.submit(message());const d={requestId:randomUUID(),body:'Thank you. I am working on this.'};
+ const reply=await admin.reply(String(r.id),d);assert.equal((await admin.reply(String(r.id),d)).duplicate,true);
+ assert.equal((await a.inbox()).unread,1);assert.equal((await a.inbox()).notifications.length,1);assert.equal((await b.inbox()).notifications.length,0);
+ await assert.rejects(b.read(String(reply.id)));await a.read(String(reply.id));assert.equal((await a.inbox()).unread,0);
+ await assert.rejects(admin.reply(String(r.id),{...d,body:'mutated retry'}));
+}));
+test('audit failure rolls back reply and notification together',()=>fixture(async(p,owner,admin)=>{
+ const a=owner('a'),r=await a.submit(message());await p.exec('REVOKE INSERT ON karpilo.feedback_audit FROM karpilo_support');
+ await assert.rejects(admin.reply(String(r.id),{requestId:randomUUID(),body:'Must roll back'}));assert.equal((await a.inbox()).notifications.length,0);
+}));
+test('public role cannot read private fields or replies and runtime cannot insert founder replies',()=>fixture(async(p)=>{
+ await assert.rejects(p.transaction(async tx=>{await tx.exec('SET LOCAL ROLE karpilo_reviews_public');await tx.query('SELECT owner_id FROM karpilo.feedback_threads');}));
+ await assert.rejects(p.transaction(async tx=>{await tx.exec('SET LOCAL ROLE karpilo_reviews_public');await tx.query('SELECT * FROM karpilo.feedback_replies');}));
+ await assert.rejects(p.transaction(async tx=>{await tx.exec('SET LOCAL ROLE karpilo_runtime');await tx.query('INSERT INTO karpilo.feedback_replies(id) VALUES($1)',[randomUUID()]);}));
+}));
