+'use client';
+import Link from 'next/link';
+import { useEffect, useRef, useState } from 'react';
+type Thread={id:string;kind:string;display_name:string;rating:number|null;body:string;publication:string;public_consent:boolean;created_at:string};
+type Reply={id:string;thread_id:string;body:string;created_at:string;read_at:string|null};
+type Data={threads:Thread[];replies:Reply[];nextOffset:number|null};
+const box='rounded-xl border border-slate-700 bg-[#17191d] p-5';
+const control='min-h-11 rounded-lg border border-slate-500 bg-[#111216] p-3';
+async function api(path='',method='GET',body?:unknown){const r=await fetch('/api/aws/account/reviews'+path,{method,cache:'no-store',headers:body?{'Content-Type':'application/json'}:undefined,body:body?JSON.stringify(body):undefined});const d=await r.json();if(!r.ok)throw Error(d.error??'Feedback unavailable');return d;}
+export function ReviewsPage(){
+ const [data,setData]=useState<Data|null>(null),[kind,setKind]=useState('feedback'),[rating,setRating]=useState(''),[name,setName]=useState(''),[body,setBody]=useState(''),[consent,setConsent]=useState(false),[error,setError]=useState(''),[notice,setNotice]=useState(''),[busy,setBusy]=useState(false),[offset,setOffset]=useState(0);
+ const key=useRef<string|null>(null),lock=useRef(false);
+ async function load(page=offset){setData(await api('?offset='+page));}
+ useEffect(()=>{let active=true;api('?offset='+offset).then(d=>{if(active)setData(d);}).catch(e=>{if(active)setError(e.message);});return()=>{active=false};},[offset]);
+ function changed(){key.current=null;setNotice('');}
+ async function send(e:React.FormEvent){e.preventDefault();if(lock.current)return;lock.current=true;setBusy(true);setError('');try{key.current??=crypto.randomUUID();await api('','POST',{requestId:key.current,kind,displayName:name,rating:rating?Number(rating):undefined,body,publicConsent:kind==='review'&&consent});key.current=null;setBody('');setConsent(false);setNotice(kind==='review'?'Review received for moderation.':'Private feedback received. Replies will appear here and in your inbox.');setOffset(0);await load(0);}catch(e){setError(e instanceof Error?e.message:'Unable to send');}finally{setBusy(false);lock.current=false;}}
+ async function withdraw(id:string){setError('');try{await api('/'+id+'/withdraw','POST');await load();}catch(e){setError(e instanceof Error?e.message:'Unable to withdraw');}}
+ return <main className="mx-auto max-w-4xl space-y-6 p-5 text-white"><nav className="flex flex-wrap gap-5"><Link href="/dashboard">Dashboard</Link><Link href="/account/inbox">Inbox</Link></nav><header><p className="text-red-300">KARPILO LOADIQ</p><h1 className="my-3 text-3xl font-bold">Reviews &amp; feedback</h1><p>Help shape the app. Send a private suggestion or share your experience as a public review.</p></header><section className={box}><form onSubmit={send}><fieldset disabled={busy} className="grid gap-4"><legend className="mb-3 text-xl font-semibold">What would you like to share?</legend><label>Message type<select className={control+' mt-2 w-full'} value={kind} onChange={e=>{setKind(e.target.value);setConsent(false);changed();}}><option value="feedback">Private feedback</option><option value="review">Public review</option></select></label><label>{kind==='review'?'Public display name':'Your name'}<input required maxLength={80} className={control+' mt-2 w-full'} value={name} onChange={e=>{setName(e.target.value);changed();}}/></label><label>Rating {kind==='feedback'?'(optional)':''}<select required={kind==='review'} className={control+' mt-2 w-full'} value={rating} onChange={e=>{setRating(e.target.value);changed();}}><option value="">Choose a rating</option>{[1,2,3,4,5].map(n=><option key={n} value={n}>{n} / 5</option>)}</select></label><label>Your experience or suggestion<textarea required maxLength={4000} rows={5} className={control+' mt-2 w-full'} value={body} onChange={e=>{setBody(e.target.value);changed();}}/></label>{kind==='review'?<label className="flex gap-3"><input type="checkbox" required checked={consent} onChange={e=>{setConsent(e.target.checked);changed();}}/>I allow my display name, rating and review to appear publicly on the Karpilo LoadIQ website after moderation. I can withdraw it here.</label>:<p className="text-slate-300">Private feedback and founder replies are visible only to you and authorized staff. They are not published as reviews.</p>}<button className="min-h-11 rounded-lg bg-red-700 p-3 font-bold" type="submit">{busy?'Sending…':'Send '+(kind==='review'?'review':'feedback')}</button></fieldset></form></section>{error&&<p role="alert">{error}</p>}{notice&&<p role="status">{notice}</p>}<section className={box}><h2 className="mb-4 text-xl font-bold">Your conversations</h2>{!data&&!error&&<p>Loading conversations…</p>}{data?.threads.length===0&&<p>No feedback submitted yet.</p>}{data?.threads.map(t=><article key={t.id} id={t.id} className="mb-5 border-b border-slate-600 pb-5"><p className="text-sm text-slate-300">{t.kind==='review'?'Review':'Private feedback'} · {t.publication} · {t.rating?t.rating+' / 5':'No rating'}</p><p className="my-3 whitespace-pre-wrap">{t.body}</p>{data.replies.filter(r=>r.thread_id===t.id).map(r=><div key={r.id} className="mt-3 rounded-lg border-l-4 border-red-600 bg-black/30 p-4"><strong>Josh · Karpilo LoadIQ</strong><p className="mt-2 whitespace-pre-wrap">{r.body}</p></div>)}{t.public_consent&&<button className={control+' mt-3'} onClick={()=>void withdraw(t.id)}>Withdraw public permission</button>}</article>)}<div className="flex gap-4">{offset>0&&<button className={control} onClick={()=>setOffset(Math.max(0,offset-50))}>Previous</button>}{data?.nextOffset!=null&&<button className={control} onClick={()=>setOffset(data.nextOffset!)}>Next</button>}</div></section><FeedbackContact/></main>;
+}
+export function FeedbackContact(){return <aside className={box}><h2 className="font-bold">Prefer email?</h2><a className="my-2 block break-all underline" href="mailto:feedback@karpilo-liq.com">feedback@karpilo-liq.com</a><p className="text-sm text-slate-300">Product feedback only. Use account support for access, security or billing. Messages submitted on this page are saved to your account; email ingestion is a separate delivery channel.</p></aside>;}
+export function FeedbackInbox(){
+ const [items,setItems]=useState<Reply[]>([]),[unread,setUnread]=useState(0),[error,setError]=useState('');
+ async function load(){const d=await api('/inbox');setItems(d.notifications);setUnread(d.unread);}
+ useEffect(()=>{void load().catch(e=>setError(e.message));},[]);
+ async function read(id:string){try{await api('/'+id+'/read','PUT');await load();}catch(e){setError(e instanceof Error?e.message:'Unable to update');}}
+ return <section className={box}><h2 className="text-xl font-bold">Feedback replies {unread>0&&<span>· {unread} unread</span>}</h2><Link className="my-3 block underline" href="/account/feedback">Open reviews &amp; feedback</Link>{error&&<p role="alert">{error}</p>}{!error&&!items.length&&<p>No feedback replies.</p>}{items.map(r=><article key={r.id} className="mt-4 border-t border-slate-600 pt-4"><strong>Josh replied to your feedback</strong><p className="my-3 whitespace-pre-wrap">{r.body}</p><Link href={'/account/feedback#'+r.thread_id} className="mr-4 underline">View conversation</Link>{!r.read_at&&<button className={control} onClick={()=>void read(r.id)}>Mark read</button>}</article>)}</section>;
+}
