@@ -0,0 +1,37 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { z } from 'zod';
+import { verifyAccess, requireSameOrigin } from '@/server/aws-backend/auth';
+import { postgresDatabase } from '@/server/aws-backend/database';
+import { subscriberReviews, moderatorReviews, requireReviews, ReviewError } from '@/server/aws-backend/reviews-service';
+import { requireFounder } from '@/server/aws-backend/support-access';
+import { accountJsonBody } from '@/server/aws-backend/request-body';
+import { AccountError } from '@/server/aws-backend/account-service';
+import { enforceRequestLimit } from '@/lib/request-limit';
+export const runtime='nodejs';
+export const dynamic='force-dynamic';
+async function handle(req:NextRequest,ctx:{params:Promise<{path?:string[]}>}){
+ const headers={'Cache-Control':'private, no-store'};
+ try{
+  requireReviews();if(req.method!=='GET')requireSameOrigin(req);
+  const claims=await verifyAccess(req.cookies.get('karpilo_aws_access')?.value??'');
+  await enforceRequestLimit(claims.sub,'account');
+  const path=(await ctx.params).path??[];let data:unknown;
+  if(path[0]==='admin'){
+   requireFounder(claims);const service=moderatorReviews(postgresDatabase('support'),claims.sub);
+   if(path.length===1&&req.method==='GET')data=await service.list(Number(req.nextUrl.searchParams.get('offset')??0));
+   else if(path.length===3&&req.method==='POST'&&path[2]==='replies')data=await service.reply(path[1],await accountJsonBody(req));
+   else if(path.length===3&&req.method==='PUT'&&path[2]==='publication')data=await service.moderate(path[1],await accountJsonBody(req));
+   else throw new AccountError(404,'Not found');
+  }else{
+   const service=subscriberReviews(postgresDatabase(),claims.sub);
+   if(path.length===0&&req.method==='GET')data=await service.list(Number(req.nextUrl.searchParams.get('offset')??0));
+   else if(path.length===0&&req.method==='POST')data=await service.submit(await accountJsonBody(req));
+   else if(path.length===1&&path[0]==='inbox'&&req.method==='GET')data=await service.inbox();
+   else if(path.length===2&&path[1]==='withdraw'&&req.method==='POST')data=await service.withdraw(path[0]);
+   else if(path.length===2&&path[1]==='read'&&req.method==='PUT')data=await service.read(path[0]);
+   else throw new AccountError(404,'Not found');
+  }
+  return NextResponse.json(data,{headers});
+ }catch(e){const status=(e instanceof AccountError||e instanceof ReviewError)?e.status:e instanceof z.ZodError?400:503;return NextResponse.json({error:(e instanceof AccountError||e instanceof ReviewError)?e.message:status===400?'Invalid feedback request':'Feedback unavailable'},{status,headers});}
+}
+export {handle as GET,handle as POST,handle as PUT};
